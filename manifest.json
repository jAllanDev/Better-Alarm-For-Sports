{
  "manifest_version": 3,
  "name": "Support Host Alert",
  "version": "1.0.0",
  "description": "Watches support pages for Cruise or Wes and plays a repeating alarm until you acknowledge it.",
  "permissions": ["storage", "offscreen"],
  "action": {
    "default_title": "Support Host Alert",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}